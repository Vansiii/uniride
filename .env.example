# UniRide — variables de entorno (SPECS/ssd.md §12)
# Copiar a .env (raíz, la usa docker compose y el backend). Nunca subir .env al repositorio.
# Sin valores reales: los secretos se completan solo en cada máquina o en el entorno de AWS.

# --- General ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=uniride
# Puerto del host; cambiarlo si ya hay un PostgreSQL local en 5432 (y ajustar las URL)
POSTGRES_PUERTO=5432
POSTGRES_USER=uniride_migraciones
POSTGRES_PASSWORD=
# Contraseña del rol uniride_app (debe coincidir con DATABASE_URL)
POSTGRES_APP_PASSWORD=
# Rol de la API: sin dueño de tablas ni BYPASSRLS (RLS forzado)
DATABASE_URL=postgresql://uniride_app:CAMBIAR@localhost:5432/uniride
# Rol dueño, solo para `prisma migrate`
DATABASE_URL_MIGRACIONES=postgresql://uniride_migraciones:CAMBIAR@localhost:5432/uniride

# --- Sesiones (HU-06) ---
JWT_ACCESO_SECRETO=
JWT_ACCESO_DURACION=15m
JWT_REFRESCO_DURACION_MOVIL=30d
JWT_REFRESCO_DURACION_WEB=7d

# --- Semilla del super administrador (HU-06). Borrar la contraseña tras el primer uso ---
SUPER_ADMIN_CORREO=
SUPER_ADMIN_CONTRASENA_INICIAL=

# --- Códigos OTP (HU-05) ---
OTP_SECRETO=

# --- Correo (HU-01) ---
# ses | consola (consola solo en desarrollo; prohibido en producción)
CORREO_MODO=consola
SES_REMITENTE=
# CORREO_MODO=brevo (sin sandbox; remitente verificado en Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UniRide
# PB-09: notificaciones push. consola (desarrollo, al log) | fcm (Firebase Cloud Messaging) | apagado (quedan en cola)
PUSH_MODO=consola
# Con PUSH_MODO=fcm: JSON de la cuenta de servicio de Firebase en base64 (base64 -w0 cuenta.json). Secreto: solo en SSM.
FCM_CUENTA_SERVICIO_B64=
# URL pública de la web (enlaces de los correos)
WEB_URL=http://localhost:5173

# --- Asistente (opcional) ---
# Sin GROQ_API_KEY el asistente responde con su lógica local. Secreto: solo en SSM.
GROQ_API_KEY=
GROQ_MODELO=qwen/qwen3.8-27b

# --- IA local (PB-10, opcional) ---
# Ollama en Kaggle por túnel SSH inverso (scripts/ia-local/README.md). Vacía: el análisis de riesgo usa Groq.
IA_LOCAL_URL=
IA_LOCAL_MODELO=qwen2.5:14b
IA_LOCAL_TIEMPO_MS=30000
IA_ANALISIS_INTERVALO_MS=60000
# PB-11: cada cuánto se busca un modelo de riesgo vencido (> 24 h) por organización
MODELO_RIESGO_INTERVALO_MS=3600000

# --- AWS ---
AWS_REGION=us-east-1
S3_BUCKET_SENSIBLE=uniride-sensible
# Vacío en AWS; MinIO en desarrollo
S3_ENDPOINT=http://localhost:9000
# Cifrado de las fotos en S3 (HU-11): kms (SSE-KMS, por defecto; AWS) | s3 (SSE-S3) | ninguno (MinIO sin KMS; el arranque falla si vale ninguno en producción)
S3_CIFRADO=kms
# Llave KMS de las fotos (id, ARN o alias); vacía usa la administrada aws/s3
S3_KMS_LLAVE_ID=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
KMS_LLAVE_RELAYER_ID=
KMS_LLAVE_VERIFICADOR_ID=
REKOGNITION_COLECCION_ROSTROS=
# Credenciales y región dedicadas para AWS Rekognition (opcional; si se omiten usa AWS_REGION y credenciales de la instancia). Face Liveness requiere us-east-1 o us-west-2
# La app abre la cámara de la prueba de vida con credenciales temporales de 15 min que la API saca de estas con STS
# GetFederationToken (POST /identidad/liveness-credenciales): sin ellas ese endpoint responde 503. El usuario IAM necesita
# `sts:GetFederationToken` y `rekognition:StartFaceLivenessSession` (la política de sesión recorta lo demás).
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
# true usa el motor facial simulado (solo desarrollo local; con NODE_ENV=production el arranque falla). Ver convenciones en backend/src/comun/motor-facial-simulado.ts
REKOGNITION_SIMULADO=false
# Secreto para el HMAC del número de carnet (HU-08); obligatorio fuera de pruebas. Genera uno largo y aleatorio, sin valor en el repositorio
IDENTIDAD_SECRETO=

# --- Atestación (HU-09) ---
# PB-07: atestación de hardware del Keystore (sin servicios externos). Paquete de la app y huella(s) SHA-256 de su firma, separadas por comas
ATESTACION_PAQUETE=com.uniride.app
ATESTACION_FIRMA_SHA256=
# false por defecto; el arranque falla si vale true en producción
MODO_EMULADOR_DEV=false

# --- Blockchain (solo red de prueba) ---
# Hardhat local: http://localhost:8545 y 31337 · Amoy: 80002
CADENA_RPC_URL=http://localhost:8545
CADENA_ID=31337
DIRECCION_TOKEN_URC=
DIRECCION_ESCROW=
EXPLORADOR_TX_URL=https://amoy.polygonscan.com/tx/
# Clave AES-256-GCM (32 bytes en hexadecimal) que cifra las llaves de las billeteras (HU-12); obligatoria fuera de
# pruebas. Generarla con `openssl rand -hex 32`. Si se pierde, las llaves guardadas ya no se pueden descifrar.
WALLET_ENCRYPTION_KEY=
# EXPO_PUBLIC_MODO_SIMULADO=true al iniciar Metro (móvil, solo desarrollo) simula Play Integrity y la prueba de vida; va con MODO_EMULADOR_DEV=true.
# true simula la cadena (solo pruebas y desarrollo; con NODE_ENV=production el arranque falla)
BLOCKCHAIN_SIMULADA=false
# Llave del relayer (HU-13): acuña recargas. Solo Hardhat y desarrollo; con NODE_ENV=production el arranque falla,
# porque allí firma con KMS_LLAVE_RELAYER_ID. Necesita ROL_ACUNADOR en UniCoin.
RELAYER_LLAVE_PRIVADA=
# Llave de la cuenta verificadora (HU-24): libera el pago del escrow al conductor. Otra cuenta que la del relayer;
# necesita ROL_VERIFICADOR en EscrowUniRide. Solo Hardhat y desarrollo: en producción firma el KMS (SP129).
VERIFICADOR_LLAVE_PRIVADA=
# La llave para desplegar contratos en Amoy NO va aquí: se guarda cifrada con
# `npx hardhat keystore set AMOY_LLAVE_DESPLIEGUE` (ver contracts/README.md).

# --- EC2 (Caddy) ---
DOMINIO_PUBLICO=

# --- Clientes (copiar a web/.env y mobile/.env) ---
VITE_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
