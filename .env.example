# UniRide — variables de entorno (SPECS/ssd.md §12)
# Copiar a .env (raíz, la usa docker compose y el backend). Nunca subir .env al repositorio.
# Sin valores reales: los secretos se completan solo en cada máquina o en el entorno de AWS.

# --- General ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=uniride
# Puerto del host; cambiarlo si ya hay un PostgreSQL local en 5432 (y ajustar las URL)
POSTGRES_PUERTO=5432
POSTGRES_USER=uniride_migraciones
POSTGRES_PASSWORD=
# Contraseña del rol uniride_app (debe coincidir con DATABASE_URL)
POSTGRES_APP_PASSWORD=
# Rol de la API: sin dueño de tablas ni BYPASSRLS (RLS forzado)
DATABASE_URL=postgresql://uniride_app:CAMBIAR@localhost:5432/uniride
# Rol dueño, solo para `prisma migrate`
DATABASE_URL_MIGRACIONES=postgresql://uniride_migraciones:CAMBIAR@localhost:5432/uniride

# --- Sesiones (HU-06) ---
JWT_ACCESO_SECRETO=
JWT_ACCESO_DURACION=15m
JWT_REFRESCO_DURACION_MOVIL=30d
JWT_REFRESCO_DURACION_WEB=7d

# --- Semilla del super administrador (HU-06). Borrar la contraseña tras el primer uso ---
SUPER_ADMIN_CORREO=
SUPER_ADMIN_CONTRASENA_INICIAL=

# --- Códigos OTP (HU-05) ---
OTP_SECRETO=

# --- Correo (HU-01) ---
# ses | consola (consola solo en desarrollo; prohibido en producción)
CORREO_MODO=consola
SES_REMITENTE=

# --- AWS ---
AWS_REGION=us-east-1
S3_BUCKET_SENSIBLE=uniride-sensible
# Vacío en AWS; MinIO en desarrollo
S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
KMS_LLAVE_RELAYER_ID=
KMS_LLAVE_VERIFICADOR_ID=
REKOGNITION_COLECCION_ROSTROS=

# --- Atestación (HU-09) ---
PLAY_INTEGRITY_PAQUETE=
GOOGLE_APPLICATION_CREDENTIALS=
# false por defecto; el arranque falla si vale true en producción
MODO_EMULADOR_DEV=false

# --- Blockchain (solo red de prueba) ---
# Hardhat local: http://localhost:8545 y 31337 · Amoy: 80002
CADENA_RPC_URL=http://localhost:8545
CADENA_ID=31337
DIRECCION_TOKEN_URC=
DIRECCION_ESCROW=
EXPLORADOR_TX_URL=https://amoy.polygonscan.com/tx/
# La llave para desplegar contratos en Amoy NO va aquí: se guarda cifrada con
# `npx hardhat keystore set AMOY_LLAVE_DESPLIEGUE` (ver contracts/README.md).

# --- EC2 (Caddy) ---
DOMINIO_PUBLICO=

# --- Clientes (copiar a web/.env y mobile/.env) ---
VITE_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
